{
  "name": "pump-contract",
  "version": "1.0.0",
  "main": "index.js",
  "license": "MIT",
  "scripts": {
    "compile": "hardhat compile",
    "deploy": "hardhat run --network bsc scripts/deploy.js",
    "deploy:bsc": "hardhat ignition deploy ignition/modules/PumpBsc.js --network bsc --verify --parameters ignition/parameters/bsc.json",
    "deploy:bsc:no-verify": "hardhat ignition deploy ignition/modules/PumpBsc.js --network bsc --parameters ignition/parameters/bsc.json",
    "deploy-chapel": "hardhat run --network chapel scripts/deploy.js",
    "test": "hardhat test",
    "test:fork:v3": "ENABLE_FORK=1 hardhat test tests/fork/v3/pancakeV4.mainnet-fork.spec.js",
    "test-ipshare": "hardhat test tests/ipshare",
    "test-pump": "hardhat test tests/pumpv2",
    "test-bc": "hardhat test tests/bondingCurve",
    "test-uniswap": "hardhat test tests/uniswap"
  },
  "dependencies": {
    "@makerdao/multicall": "^0.12.0",
    "@nomiclabs/hardhat-ethers": "^2.2.3",
    "@nomiclabs/hardhat-etherscan": "^3.1.8",
    "@nomiclabs/hardhat-waffle": "^2.0.6",
    "@openzeppelin/contracts": "^5.6.1",
    "@openzeppelin/test-helpers": "^0.5.16",
    "@uniswap/hardhat-v3-deploy": "^0.1.1",
    "@uniswap/v2-core": "^1.0.1",
    "@uniswap/v2-periphery": "^1.1.0-beta.0",
    "@uniswap/v3-core": "^1.0.1",
    "@uniswap/v3-periphery": "^1.4.4",
    "@uniswap/v4-core": "^1.0.2",
    "@uniswap/v4-periphery": "^1.0.3",
    "dotenv": "^16.4.7",
    "ethereum-waffle": "^4.0.10",
    "hardhat": "^2.22.4",
    "hardhat-contract-sizer": "^2.10.0",
    "infinity-core": "github:pancakeswap/pancake-v4-core",
    "prettier": "^3.2.5",
    "prettier-plugin-solidity": "^1.3.1",
    "solady": "^0.0.201",
    "solhint": "^5.0.1",
    "solhint-plugin-prettier": "^0.1.0"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.0.0",
    "@nomicfoundation/hardhat-ethers": "^3.0.0",
    "@nomicfoundation/hardhat-ignition": "^0.15.0",
    "@nomicfoundation/hardhat-ignition-ethers": "^0.15.0",
    "@nomicfoundation/hardhat-network-helpers": "^1.0.0",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@nomicfoundation/hardhat-verify": "^2.0.0",
    "@typechain/ethers-v6": "^0.5.0",
    "@typechain/hardhat": "^9.0.0",
    "chai": "^4.2.0",
    "ethers": "^6.13.4",
    "hardhat-gas-reporter": "^2.1.1",
    "solidity-coverage": "^0.8.12",
    "typechain": "^8.3.0"
  }
}
